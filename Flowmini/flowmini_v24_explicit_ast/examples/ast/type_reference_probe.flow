program type_reference_probe

type IntList refines collection.list<int>

type MatrixBox {
    field values : array<math.scalar>[Rows, 2]
    field fallback : optional<collection.list<int>>
}

fn transform(
    input : optional<collection.list<int>>,
    grid : array<int>[2, 3]
) -> result.Result<array<int>, Error> {
    local : optional<collection.list<int>>([1, 2, 3])
    scratch : array<int>[Rows, 2]([1, 2, 3, 4])
    return grid
}

main {
    values : collection.list<int>([1, 2, 3])
}
