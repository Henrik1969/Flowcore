import "../../std/abi/memory.flow"

program abi_memory_demo

main {
    destination : c_pointer(0)
    source      : c_pointer(0)
    count       : c_size_t(0)
    value       : c_int(0)
    result      : c_int(0)

    memset(destination, value, count) -> destination
    memcpy(destination, source, count) -> destination
    memcmp(destination, source, count) -> result
    print result
}
