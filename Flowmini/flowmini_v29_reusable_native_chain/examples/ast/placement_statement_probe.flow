program placement_statement_probe

type Gear {
    field teeth : int
    field rpm : int
}

type GearPair {
    field driver : Gear
    field driven : Gear
}

fn keep(value : int): int {
    value -> return
}

main {
    scalar : int(0)
    i : int(0)
    j : int(1)
    values : list<int>([0, 0])
    matrix : array<int>[2, 2]([0, 0, 0, 0])
    driver : Gear({teeth:12, rpm:100})
    driven : Gear({teeth:36, rpm:0})
    pair : GearPair({driver:driver, driven:driven})

    keep(scalar) -> scalar
    42 -> pair.driven.rpm
    42 -> values[i]
    42 -> matrix[i, j]
}
