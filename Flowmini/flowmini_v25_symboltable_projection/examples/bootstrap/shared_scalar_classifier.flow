program shared_scalar_classifier

enum ScalarClass {
    digit
    whitespace
    other
}

fn scalar_class(value : int): ScalarClass {
    when value {
        case 48..57 {
            ScalarClass.digit -> return
        }
        case 32 {
            ScalarClass.whitespace -> return
        }
        default {
            ScalarClass.other -> return
        }
    }
}

fn tokenizer_probe(value : int): ScalarClass {
    scalar_class(value) -> return
}

fn document_probe(value : int): ScalarClass {
    scalar_class(value) -> return
}

main {
    scalar : int(53)
    token_class : ScalarClass(ScalarClass.other)
    document_class : ScalarClass(ScalarClass.other)

    tokenizer_probe(scalar) -> token_class
    document_probe(scalar) -> document_class
    guard token_class == document_class else {
        print 99
    }
    print scalar
}
