program utf8_source_reader_probe

type Diagnostic {
    field code : int
    field offset : int
}

type Utf8Outcome {
    field valid : Bool
    field scalar_count : int
    field diagnostic_count : int
}

// This is the first Flow-side consumer of the captured UTF-8 contract. The
// current language slice can represent byte lists, scalar arithmetic, indexed
// access, and bounded loops. General byte/file input and diagnostic records
// remain the next library work; the probe keeps those missing facilities
// visible.

main {
    bytes : list<int>([65,195,166])
    ascii : int(bytes[0])
    lead : int(bytes[1])
    continuation : int(bytes[2])
    decoded : int(0)
    index : int(0)
    scalar_count : int(0)
    malformed : list<int>([65,192,175,66])
    malformed_index : int(0)
    diagnostic_count : int(0)
    first_diagnostic : Diagnostic({code: 1, offset: 1})
    second_diagnostic : Diagnostic({code: 2, offset: 2})
    diagnostic_codes : list<int>([1,2])
    diagnostic_offsets : list<int>([1,2])
    diagnostic_index : int(0)

    while index < length(bytes) {
        if bytes[index] < 128 {
            scalar_count + 1 -> scalar_count
            index + 1 -> index
        } else {
            (bytes[index] - 192) * 64 + bytes[index + 1] - 128 -> decoded
            scalar_count + 1 -> scalar_count
            index + 2 -> index
        }
    }

    while malformed_index < length(malformed) {
        if malformed[malformed_index] < 128 {
            malformed_index + 1 -> malformed_index
        } else {
            if malformed[malformed_index] < 194 {
                diagnostic_count + 1 -> diagnostic_count
                malformed_index + 1 -> malformed_index
            } else {
                if malformed[malformed_index] <= 191 {
                    diagnostic_count + 1 -> diagnostic_count
                }
                malformed_index + 1 -> malformed_index
            }
        }
    }

    valid : Bool(false)
    if diagnostic_count == 2 {
        true -> valid
    }
    outcome : Utf8Outcome({valid: valid, scalar_count: scalar_count, diagnostic_count: diagnostic_count})

    if ascii == 65 {
        if decoded == 230 {
            if scalar_count == 2 {
                if outcome.valid {
                    if first_diagnostic.code == 1 {
                        if second_diagnostic.offset == 2 {
                            diagnostic_codes[diagnostic_index] -> decoded
                            diagnostic_offsets[diagnostic_index] -> index
                            if decoded == 1 {
                                if index == 1 {
                                    diagnostic_index + 1 -> diagnostic_index
                                    diagnostic_codes[diagnostic_index] -> decoded
                                    diagnostic_offsets[diagnostic_index] -> index
                                    if decoded == 2 {
                                        if index == 2 {
                                            1 -> return
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    0 -> return
}
