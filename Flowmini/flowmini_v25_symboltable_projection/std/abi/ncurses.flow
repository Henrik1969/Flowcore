unit std_abi_ncurses

abi ncurses {
    library "libncursesw.so.6"
    convention c

    type c_pointer {
        repr "void*"
        ownership external
        access opaque
        lifetime external
        nullable true
        opaque true
        cleanup endwin
    }

    type c_string {
        repr "const char*"
        ownership borrowed
        access read
        lifetime call
        nullable false
        terminator nul
    }

    extern fn initscr(): c_pointer {
        symbol "initscr"
        effect terminal
    }

    extern fn endwin(): c_int {
        symbol "endwin"
        effect terminal
    }

    extern fn noecho(): c_int {
        symbol "noecho"
        effect terminal
    }

    extern fn cbreak(): c_int {
        symbol "cbreak"
        effect terminal
    }

    extern fn waddnstr(window : c_pointer, text : c_string, count : c_int): c_int {
        symbol "waddnstr"
        effect terminal
    }

    extern fn wrefresh(window : c_pointer): c_int {
        symbol "wrefresh"
        effect terminal
    }

    extern fn wgetch(window : c_pointer): c_int {
        symbol "wgetch"
        effect terminal
    }

    extern fn keypad(window : c_pointer, enabled : c_int): c_int {
        symbol "keypad"
        effect terminal
    }
}
