#!/bin/sh
set -eu

policy_root=${FLOW_SELECTION_POLICY_ROOT:-/etc/flowcore/selection}
provider=
if test "${1:-}" = --provider; then
    test "$#" -ge 3 || { echo 'flowselect: --provider requires a provider and candidates' >&2; exit 2; }
    provider=$2
    shift 2
else
    policy_file=$policy_root/provider
    test ! -r "$policy_root/provider.local" || policy_file=$policy_root/provider.local
    test -r "$policy_file" || { echo 'flowselect: provider policy is absent' >&2; exit 2; }
    IFS= read -r provider < "$policy_file"
fi

case "$provider" in native|fzf) :;; *) echo "flowselect: unauthorized provider: $provider" >&2; exit 2;; esac
test "$#" -gt 0 || { echo 'flowselect: at least one candidate is required' >&2; exit 2; }
for candidate do
    case "$candidate" in *'
'*) echo 'flowselect: candidates may not contain newline' >&2; exit 2;; esac
done

run_provider() {
    provider_name=$1
    shift
    command_path="/usr/libexec/flowselection/flowselect-$provider_name"
    test -x "$command_path" || return 127
    "$command_path" "$@"
}

set +e
run_provider "$provider" "$@"
status=$?
set -e
if test "$status" -ne 127; then exit "$status"; fi

test -r "$policy_root/fallback" || { echo "flowselect: provider unavailable: $provider" >&2; exit 2; }
IFS= read -r fallback < "$policy_root/fallback"
test "$fallback" = native || { echo "flowselect: unauthorized fallback: $fallback" >&2; exit 2; }
run_provider native "$@"
