{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowcore.example/schemas/frankencore-project-statuses-v1.json",
  "title": "Frankencore project-local status and provider metadata",
  "type": "object",
  "required": ["format", "version", "scope", "project", "statuses", "provider_claims"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "frankencore.project_status_metadata" },
    "version": { "const": 1 },
    "scope": { "const": "project" },
    "project": {
      "type": "object",
      "required": ["id", "owner"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 }
      }
    },
    "statuses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "owner", "meaning", "scope", "terminal"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" },
          "owner": { "type": "string", "minLength": 1 },
          "meaning": { "type": "string", "minLength": 1 },
          "scope": { "const": "project" },
          "terminal": { "type": "boolean" },
          "allowed_from": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "provider_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["provider", "supports", "contract_version", "informative_only"],
        "additionalProperties": false,
        "properties": {
          "provider": { "type": "string", "minLength": 1 },
          "supports": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "contract_version": { "type": "integer", "minimum": 1 },
          "informative_only": { "const": true },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
