{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowcore.example/schemas/frankencore-language-map-v1.json",
  "title": "Frankencore language map",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "id", "revision", "parser", "parent", "monikers"],
  "properties": {
    "format": {"const": "frankencore.language-map"},
    "version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "parser": {"type": "string", "minLength": 1},
    "parent": {"type": "string", "minLength": 1},
    "dialects": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "profiles": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "monikers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
    }
  }
}
