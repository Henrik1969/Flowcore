{
  "format": "flowlfs.package-recipe",
  "version": 0,
  "package": "zsh",
  "upstream_version": "5.9.2",
  "recipe_authority": "BLFS development r13.0-1379 systemd",
  "control_comparison": "BLFS 13.0 systemd zsh-5.9",
  "target": "x86_64-flowlfs-linux-gnu",
  "build_user": "flowbuilder",
  "source_date_epoch": 1783881773,
  "required_capabilities": [
    "c-compiler",
    "make",
    "texinfo",
    "libcap",
    "gdbm",
    "pcre2"
  ],
  "configure": [
    "--prefix=/usr",
    "--sysconfdir=/etc/zsh",
    "--enable-etcdir=/etc/zsh",
    "--enable-cap",
    "--enable-gdbm",
    "--enable-pcre"
  ],
  "test": "make check",
  "install_boundary": "DESTDIR staging only",
  "activation": {
    "filesystem_projection": "symlink",
    "shared_state": "/etc/shells contributes /bin/zsh",
    "default_shell_change": false
  }
}
