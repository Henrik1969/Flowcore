import "../../../std/abi/terminal.flow" as terminal
import "../../../std/abi/libc.flow" as libc

program sel

main(args : list<string>) {
    session : terminal_session(0)
    status : c_int(0)
    key : c_int(0)
    count : c_int(76)
    message : c_string("Flowcore sel\n\n> alpha\n  beta\n  gamma\n\nUp/Down: move  Enter: select  q: quit\n")
    selected : c_string("selected: alpha")
    cancelled : c_string("selection: none")

    terminal.open() -> session
    terminal.enter() -> status
    terminal.write(message, count) -> status
    terminal.present() -> status
    terminal.read_event() -> key
    terminal.close() -> status
    if key == 113 {
        libc.puts(cancelled) -> status
        return 1
    } else {
        libc.puts(selected) -> status
        return 0
    }
}
