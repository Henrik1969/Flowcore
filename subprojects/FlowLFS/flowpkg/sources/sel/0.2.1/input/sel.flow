import "../../../std/abi/terminal.flow" as terminal
import "../../../std/abi/libc.flow" as libc

program sel

main(args : list<string>) {
    session : terminal_session(0)
    status : c_int(0)
    key : c_int(0)
    selection : c_int(0)
    done : c_int(0)
    cancelled_state : c_int(0)
    zero : c_int(0)
    one : c_int(1)
    two : c_int(2)
    event_enter : c_int(256)
    event_up : c_int(258)
    event_down : c_int(259)
    count : c_int(76)
    message : c_string("Flowcore sel\n\n> alpha\n  beta\n  gamma\n\nUp/Down: move  Enter: select  q: quit\n")
    cursor_alpha : c_string("cursor: alpha\n")
    cursor_beta : c_string("cursor: beta\n")
    cursor_gamma : c_string("cursor: gamma\n")
    selected_alpha : c_string("selected: alpha")
    selected_beta : c_string("selected: beta")
    selected_gamma : c_string("selected: gamma")
    cancelled : c_string("selection: none")

    terminal.open() -> session
    terminal.enter() -> status
    terminal.write(message, count) -> status
    terminal.present() -> status
    while done < one {
        terminal.read_event() -> key
        if key == 113 {
            one -> cancelled_state
            one -> done
        } else {
            if key == event_enter {
                one -> done
            } else {
                if key == event_up {
                    if selection > zero {
                        selection - one -> selection
                    }
                } else {
                    if key == event_down {
                        if selection < two {
                            selection + one -> selection
                        }
                    }
                }
                if selection == zero {
                    terminal.write(cursor_alpha, 14) -> status
                } else {
                    if selection == one {
                        terminal.write(cursor_beta, 13) -> status
                    } else {
                        terminal.write(cursor_gamma, 14) -> status
                    }
                }
                terminal.present() -> status
            }
        }
    }
    terminal.close() -> status
    if cancelled_state == one {
        libc.puts(cancelled) -> status
        return 1
    } else {
        if selection == zero {
            libc.puts(selected_alpha) -> status
        } else {
            if selection == one {
                libc.puts(selected_beta) -> status
            } else {
                libc.puts(selected_gamma) -> status
            }
        }
        return 0
    }
}
